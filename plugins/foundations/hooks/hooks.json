{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "if": "Bash(git checkout -b *) || Bash(git switch -c *)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate-branch-name.sh\""
          }
        ]
      }
    ]
  }
}
